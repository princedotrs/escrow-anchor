    program_idl = action.deploy_escrow_anchor.program_idl
    block_height = 0 // action.deploy_escrow_anchor.block_height
    event {
        name = "RefundEvent"
    }
}

action "escrow_anchor_take_event" "svm::deploy_subgraph" {
    program_id = action.deploy_escrow_anchor.program_id
    program_idl = action.deploy_escrow_anchor.program_idl
    block_height = 0 // action.deploy_escrow_anchor.block_height
